{
    "name": "learn-testing",
    "version": "1.0.4",
    "private": true,
    "scripts": {
        "start": "tsx server/main.ts",
        "dev": "cd backend && go run main.go",
        "dev:root": "go run ./backend",
        "test:backend": "cd backend && go test -v",
        "test:root": "go test ./backend -v",
        "build:backend": "cd backend && go build -o ../device-management main.go",
        "build:root": "go build -o device-management ./backend",
        "build": "docker build -t device-management .",
        "deploy": "docker run -p 8080:8080 device-management"
    },
    "dependencies": {
        "tsx": "^4.20.3"
    },
    "devDependencies": {
        "@getgauge/cli": "^1.6.19",
        "@playwright/test": "^1.55.0",
        "@reportportal/agent-js-playwright": "^5.2.2",
        "@reportportal/agent-js-vitest": "^5.1.1",
        "@sonar/scan": "^4.3.0",
        "@types/node": "^24.0.15",
        "@vitest/coverage-v8": "^3.2.4",
        "gauge-ts": "^0.3.5",
        "playwright": "^1.54.2",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4",
        "vitest-sonar-reporter": "^2.0.4"
    },
    "overrides": {
        "glob": "^11.0.3"
    }
}
